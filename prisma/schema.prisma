generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model archivos {
  id_archivo     Int        @id @default(autoincrement())
  id_respuesta   Int
  nombre_archivo String     @db.VarChar(255)
  archivo_url    String     @db.VarChar(255)
  fecha_creacion DateTime?  @default(now()) @db.DateTime(0)
  respuestas     respuestas @relation(fields: [id_respuesta], references: [id_respuesta], onDelete: Cascade, onUpdate: NoAction, map: "archivos_ibfk_1")

  @@index([id_respuesta], map: "id_respuesta")
}

model contacto {
  id_contacto    Int       @id @default(autoincrement())
  id_usuario     Int?
  nombre         String    @db.VarChar(150)
  email          String    @db.VarChar(150)
  telefono       String?   @db.VarChar(20)
  asunto         String    @db.VarChar(200)
  mensaje        String    @db.Text
  estado         String?   @default("Pendiente") @db.VarChar(50)
  fecha_creacion DateTime? @default(now()) @db.DateTime(0)
  usuarios       usuarios? @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction, map: "contacto_ibfk_1")

  @@index([id_usuario], map: "id_usuario")
}

model estados {
  id_estado     Int          @id @default(autoincrement())
  nombre_estado String       @db.VarChar(100)
  municipios    municipios[]
}

model formularios {
  id_formulario Int          @id @default(autoincrement())
  nombre        String       @db.VarChar(150)
  descripcion   String?      @db.Text
  respuestas    respuestas[]
}

model municipios {
  id_municipio     Int        @id @default(autoincrement())
  id_estado        Int
  nombre_municipio String     @db.VarChar(100)
  estados          estados    @relation(fields: [id_estado], references: [id_estado], onDelete: Cascade, onUpdate: NoAction, map: "municipios_ibfk_1")
  usuarios         usuarios[]

  @@index([id_estado], map: "id_estado")
}

model noticias {
  id_noticia        Int       @id @default(autoincrement())
  id_usuario        Int
  titulo            String    @db.VarChar(255)
  contenido         String    @db.Text
  fecha_publicacion DateTime? @default(now()) @db.DateTime(0)
  url_imagen        String?   @db.VarChar(255)
  estatus           String?   @default("Activo") @db.VarChar(20)
  usuarios          usuarios  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "noticias_ibfk_1")

  @@index([id_usuario], map: "id_usuario")
}

model respuestas {
  id_respuesta    Int         @id @default(autoincrement())
  id_formulario   Int
  id_usuario      Int
  fecha_respuesta DateTime?   @default(now()) @db.DateTime(0)
  respuesta_json  Json
  archivos        archivos[]
  formularios     formularios @relation(fields: [id_formulario], references: [id_formulario], onDelete: Cascade, onUpdate: NoAction, map: "respuestas_ibfk_1")
  usuarios        usuarios    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "respuestas_ibfk_2")

  @@index([id_formulario], map: "id_formulario")
  @@index([id_usuario], map: "id_usuario")
}

model roles {
  id_rol         Int              @id @default(autoincrement())
  nombre_rol     String           @unique(map: "nombre_rol") @db.VarChar(50)
  descripcion    String?          @db.Text
  usuarios_roles usuarios_roles[]
}

model tramites {
  id_tramite Int      @id @default(autoincrement())
  id_usuario Int
  nombre     String   @db.VarChar(255)
  contenido  String   @db.Text
  url_imagen String?  @db.VarChar(255)
  usuarios   usuarios @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "tramites_ibfk_1")

  @@index([id_usuario], map: "id_usuario")
}

model usuarios {
  id_usuario       Int              @id @default(autoincrement())
  nombre           String           @db.VarChar(100)
  apellido_paterno String           @db.VarChar(100)
  apellido_materno String?          @db.VarChar(100)
  fecha_nacimiento DateTime?        @db.Date
  curp             String?          @unique(map: "curp") @db.VarChar(18)
  telefono         String?          @db.VarChar(20)
  id_municipio     Int
  codigo_postal    String?          @db.VarChar(10)
  correo           String           @unique(map: "correo") @db.VarChar(150)
  password         String           @db.VarChar(255)
  genero           String?          @db.VarChar(50)
  estatus          String?          @default("Activo") @db.VarChar(20)
  contacto         contacto[]
  noticias         noticias[]
  respuestas       respuestas[]
  tramites         tramites[]
  municipios       municipios       @relation(fields: [id_municipio], references: [id_municipio], onDelete: NoAction, onUpdate: NoAction, map: "usuarios_ibfk_1")
  usuarios_roles   usuarios_roles[]

  @@index([id_municipio], map: "id_municipio")
}

model usuarios_roles {
  id_usuario Int
  id_rol     Int
  usuarios   usuarios @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "usuarios_roles_ibfk_1")
  roles      roles    @relation(fields: [id_rol], references: [id_rol], onDelete: Cascade, onUpdate: NoAction, map: "usuarios_roles_ibfk_2")

  @@id([id_usuario, id_rol])
  @@index([id_rol], map: "id_rol")
}
